<Window x:Class="FreeDWGEditorThatWorks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:FreeDWGEditorThatWorks.Controls"
        mc:Ignorable="d"
        Title="FreeDWG Editor" Height="700" Width="1100">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="Open..." Padding="10,2" Click="OnOpenClick"
                        ToolTip="Open a DWG or DXF drawing (Ctrl+O)" />
                <Separator />
                <Button Content="Zoom Extents" Padding="10,2" Click="OnZoomExtentsClick"
                        ToolTip="Fit the whole drawing in the viewport" />
                <Separator />
                <CheckBox x:Name="LineweightsToggle" Content="Lineweights" VerticalAlignment="Center"
                          Margin="4,0" Click="OnLineweightsToggled"
                          ToolTip="Show plot widths instead of hairlines" />
                <CheckBox x:Name="LightBackgroundToggle" Content="Light background" VerticalAlignment="Center"
                          Margin="8,0" Click="OnBackgroundToggled" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="No drawing loaded." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinateText" FontFamily="Consolas" Text="" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayerColumn" Width="230" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="4">
                <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                    <TextBlock Text="Layers" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="LayerCountText" HorizontalAlignment="Right" Opacity="0.6"
                               VerticalAlignment="Center" />
                </Grid>

                <ListBox x:Name="LayerList" BorderThickness="1"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <Border Grid.Column="1" Width="13" Height="13" Margin="4,0,6,0"
                                        Background="{Binding Swatch}" BorderBrush="#66000000"
                                        BorderThickness="1" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3" Text="{Binding EntityCount}" Opacity="0.5"
                                           Margin="6,0,2,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Column="2">
                <ctl:CadCanvas x:Name="Canvas" />
                <TextBlock x:Name="EmptyHint"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7F8C99" FontSize="15" IsHitTestVisible="False"
                           Text="Open a .dwg or .dxf to begin&#x0a;Scroll to zoom, drag to pan"
                           TextAlignment="Center" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
