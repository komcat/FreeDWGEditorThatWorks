<Window x:Class="FreeDWGEditorThatWorks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:FreeDWGEditorThatWorks.Controls"
        xmlns:vm="clr-namespace:FreeDWGEditorThatWorks.ViewModels"
        mc:Ignorable="d"
        Title="FreeDWG Editor" Height="700" Width="1100">
    <DockPanel>
        <!--
            Icons rather than words: the text toolbar ran out of room at four
            buttons, and a drawing tool that spells out its commands is a
            drawing tool nobody has used before.

            A plain panel rather than a ToolBar, because ToolBar insists on an
            overflow chevron and a drag gripper this window has no use for. It
            showed the chevron with eight buttons and room to spare.
        -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Tool.Divider}" Background="#FFF7F9FC">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.New}"
                        Click="OnNewClick" ToolTip="New drawing  (Ctrl+N)" />
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Open}"
                        Click="OnOpenClick" ToolTip="Open a DWG or DXF drawing  (Ctrl+O)" />
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Save}"
                        IsEnabled="False" ToolTip="Save  -  arrives with E5, which applies edits back onto the original document" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Undo}"
                        Click="OnUndoClick" IsEnabled="False" ToolTip="Undo  (Ctrl+Z)" />
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Redo}"
                        Click="OnRedoClick" IsEnabled="False" ToolTip="Redo  (Ctrl+Y)" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Settings}"
                        Click="OnSettingsClick" ToolTip="Drawing settings  -  units and decimal places" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ZoomExtents}"
                        Click="OnZoomExtentsClick" ToolTip="Zoom extents  -  fit the whole drawing in the viewport" />
                <ToggleButton x:Name="ZoomWindowToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.ZoomWindow}" Click="OnZoomWindowToggled"
                              ToolTip="Zoom window  -  drag a rectangle to zoom into it" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="LineweightsToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Lineweights}" Click="OnLineweightsToggled"
                              ToolTip="Lineweights  -  show plot widths instead of hairlines" />
                <ToggleButton x:Name="LightBackgroundToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Background}" Click="OnBackgroundToggled"
                              ToolTip="Light background" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Grid}" Click="OnGridToggled"
                              ToolTip="Grid  -  show it, and snap to it when nothing else is near" />
                <ToggleButton x:Name="OrthoToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Ortho}" Click="OnSnapToggled"
                              ToolTip="Ortho  -  hold each new point square with the last one" />
                <ToggleButton x:Name="PolarToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Polar}" Click="OnSnapToggled"
                              ToolTip="Polar  -  attract each new point to regular angles from the last one" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="EndpointSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapEndpoint}" Click="OnSnapToggled"
                              ToolTip="Snap to endpoints and vertices" />
                <ToggleButton x:Name="MidpointSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapMidpoint}" Click="OnSnapToggled"
                              ToolTip="Snap to midpoints" />
                <ToggleButton x:Name="CenterSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapCenter}" Click="OnSnapToggled"
                              ToolTip="Snap to centres of circles, arcs and ellipses" />
                <ToggleButton x:Name="QuadrantSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapQuadrant}" Click="OnSnapToggled"
                              ToolTip="Snap to quadrants  -  the top, bottom, left and right of a circle" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="PerpendicularSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapPerpendicular}" Click="OnSnapToggled"
                              ToolTip="Snap perpendicular  -  square onto a line or arc from the point you are drawing from" />
                <ToggleButton x:Name="TangentSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapTangent}" Click="OnSnapToggled"
                              ToolTip="Snap tangent  -  where a line from the point you are drawing from just touches a circle" />
                <ToggleButton x:Name="IntersectionSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapIntersection}" Click="OnSnapToggled"
                              ToolTip="Snap to intersections  -  where two objects cross" />
                <ToggleButton x:Name="TrackingSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapTracking}" Click="OnSnapToggled"
                              ToolTip="Tracking  -  hover a point to acquire it, then line up level with it or above it" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="No drawing loaded." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinateText" FontFamily="Consolas" Text="" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <!--
                Tools on the left, properties beside them, the drawing in the
                middle, layers on the right. Layers came out from under
                Properties because the two were sharing one narrow column and
                both wanted the height: a real file brings fifty layers and
                that panel was showing eight of them.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="230" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="LayerColumn" Width="240" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!--
                Draw and Modify, in AutoCAD's own order so that muscle memory
                transfers. Three columns because one would be 28 buttons tall and
                run off the bottom of a 700px window; two still needed a scrollbar.

                The tools that are still disabled say in their tooltip what
                they are waiting for. Nothing here touches the drawing
                directly: a tool hands back an entity and the canvas puts it
                on the command stack, which is the only way in.
            -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Tool.Divider}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,2,6">
                        <TextBlock Text="Draw" Style="{StaticResource PaletteGroupLabel}" />

                        <UniformGrid Columns="3" Width="108" HorizontalAlignment="Center">
                            <RadioButton x:Name="SelectButton" GroupName="Tool" Style="{StaticResource ToolToggle}"
                                         Tag="{StaticResource Icon.Select}" IsChecked="True" Click="OnToolPicked"
                                         ToolTip="Select  -  click to pick, drag left to right for a window, right to left to cross" />
                            <RadioButton x:Name="LineButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Line}" ToolTip="Line  -  two points" />
                            <RadioButton x:Name="PolylineButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Polyline}" ToolTip="Polyline  -  any number of points, Enter or right-click to finish" />
                            <RadioButton x:Name="RectangleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Rectangle}" ToolTip="Rectangle  -  two opposite corners" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Polygon}" ToolTip="Polygon  -  needs somewhere to ask for a side count; typed entry takes lengths only so far" />
                            <RadioButton x:Name="CircleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Circle}" ToolTip="Circle  -  centre, then a point on the rim" />
                            <RadioButton x:Name="ArcButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Arc}" ToolTip="Arc  -  start, a point on the arc, then the end" />
                            <RadioButton x:Name="EllipseButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Ellipse}" ToolTip="Ellipse  -  centre, the end of the major axis, then the minor" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Spline}" ToolTip="Spline  -  needs control point entry, and did not come with the other draw tools" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Point}" ToolTip="Point  -  POINT is not imported yet either" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Hatch}" ToolTip="Hatch  -  needs a boundary to be traced or found, which none of the draw tools do" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Text}" ToolTip="Text  -  needs an editor to type into on the canvas" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Block}" ToolTip="Insert block  -  needs a chooser for the definitions the drawing already holds" />
                        </UniformGrid>

                        <Separator Margin="4,8" Background="{StaticResource Tool.Divider}" />
                        <TextBlock Text="Modify" Style="{StaticResource PaletteGroupLabel}" />

                        <UniformGrid Columns="3" Width="108" HorizontalAlignment="Center">
                            <Button x:Name="EraseButton" Style="{StaticResource ToolButton}" Click="OnEraseClick"
                                    Tag="{StaticResource Icon.Erase}" ToolTip="Erase the selection  (Delete)" />
                            <RadioButton x:Name="MoveButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Move}" ToolTip="Move  -  select first, then pick a base point and where it goes" />
                            <RadioButton x:Name="CopyButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Copy}" ToolTip="Copy  -  select first, then pick a base point and where the copy goes" />
                            <RadioButton x:Name="RotateButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Rotate}" ToolTip="Rotate  -  select first, then pick the centre and the angle" />
                            <RadioButton x:Name="ScaleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Scale}" ToolTip="Scale  -  select first, then pick a base point, a reference and where it should reach" />
                            <RadioButton x:Name="MirrorButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Mirror}" ToolTip="Mirror  -  select first, then pick the mirror line. The original is kept" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Offset}" ToolTip="Offset  -  needs curve offsetting, which is a job of its own for splines and ellipses" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Array}" ToolTip="Array  -  needs somewhere to ask for row and column counts" />
                            <RadioButton x:Name="TrimButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Trim}" ToolTip="Trim  -  click the part of a line or arc to cut away" />
                            <RadioButton x:Name="ExtendButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Extend}" ToolTip="Extend  -  click near the end to push out to its neighbour" />
                            <RadioButton x:Name="FilletButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Fillet}" ToolTip="Fillet  -  click two edges on the sides to keep, or two segments of one polyline. Type a number to set the radius; 0 makes a sharp corner" />
                            <RadioButton x:Name="ChamferButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Chamfer}" ToolTip="Chamfer  -  click two edges on the sides to keep, or two segments of one polyline. Type a number to set how far back it cuts" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Stretch}" ToolTip="Stretch  -  a crossing window that moves every vertex inside it. Single vertices already move: select an object and drag a grip" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Explode}" ToolTip="Explode  -  needs breaking a block or a polyline into its parts" />
                            <RadioButton x:Name="TangentButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Tangent}" ToolTip="Tangent  -  click a circle, then a line it should sit against" />
                        </UniformGrid>

                        <!--
                            Dimensions get a group of their own rather than a
                            corner of Draw, which is where AutoCAD puts them
                            and what a drawing office actually does with them:
                            they are annotation, they go on their own layer,
                            and they are reached for as a job of their own
                            once the geometry is finished.
                        -->
                        <Separator Margin="4,8" Background="{StaticResource Tool.Divider}" />
                        <TextBlock Text="Dimensions" Style="{StaticResource PaletteGroupLabel}" />

                        <UniformGrid Columns="3" Width="108" HorizontalAlignment="Center">
                            <RadioButton x:Name="DimensionButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Dimension}" ToolTip="Linear  -  pick two points, then pull the line out. Above or below measures across, to the side measures up" />
                            <RadioButton x:Name="AlignedDimensionButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.DimensionAligned}" ToolTip="Aligned  -  the true distance between two points, parallel to them" />
                            <RadioButton x:Name="RadiusDimensionButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.DimensionRadius}" ToolTip="Radius  -  click a circle or an arc, then say where the number goes" />
                            <RadioButton x:Name="DiameterDimensionButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.DimensionDiameter}" ToolTip="Diameter  -  the same, measured right across" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.DimensionAngular}" ToolTip="Angular  -  needs a dimension line that is an arc, which is a second layout rather than a variation on this one" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.DimensionBaseline}" ToolTip="Baseline  -  a run of dimensions from one origin. Needs to pick an existing dimension to continue from" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.DimensionContinue}" ToolTip="Continue  -  the same, end to end instead of stacked" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

<!--
                Properties over Layers, with the settings that used to be
                loose in the toolbar folded into the top of it. A grid of
                name and value is what every CAD and every IDE puts this
                sort of thing in, so it needs no explaining, and it has room
                for the selected object's geometry as well, which a box on a
                toolbar never would have.
            -->
            <Grid Grid.Column="1" Margin="4">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                        <TextBlock Text="Properties" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="PropertyScopeText" HorizontalAlignment="Right" Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- The description of the selected row, as a property grid does. -->
                    <Border DockPanel.Dock="Bottom" BorderThickness="1,0,1,1" Padding="6,4" MinHeight="46"
                            BorderBrush="{StaticResource Tool.Divider}" Background="#FFF7F9FC">
                        <StackPanel>
                            <TextBlock x:Name="PropertyHelpName" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PropertyHelpText" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PropertyGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1"
                              SelectionMode="Single" SelectionUnit="FullRow" RowHeight="22"
                              HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnPropertyRowSelected"
                              RowBackground="White" AlternatingRowBackground="#FFF8FAFC"
                              HorizontalGridLinesBrush="{StaticResource Tool.Divider}"
                              VerticalGridLinesBrush="{StaticResource Tool.Divider}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Binding="{Binding Name}"
                                                IsReadOnly="True" Width="1.1*" />
                            <DataGridTemplateColumn Header="Value" Width="*"
                                                    CellTemplateSelector="{x:Null}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <!-- A colour chip, for the rows that carry one. -->
                                            <Border Width="11" Height="11" Margin="0,0,5,0"
                                                    BorderBrush="#66000000" BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Swatch}"
                                                    Visibility="{Binding HasSwatch,
                                                        Converter={StaticResource ShowIfTrue}}" />
                                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplateSelector>
                                    <vm:PropertyEditorSelector>
                                        <vm:PropertyEditorSelector.Text>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                         BorderThickness="0" Padding="3,0"
                                                         VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </vm:PropertyEditorSelector.Text>
                                        <vm:PropertyEditorSelector.Choice>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Choices}"
                                                          SelectedItem="{Binding Value}"
                                                          IsEditable="False" BorderThickness="0"
                                                          VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </vm:PropertyEditorSelector.Choice>
                                    </vm:PropertyEditorSelector>
                                </DataGridTemplateColumn.CellEditingTemplateSelector>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <Border Background="#FFEDF1F6" Padding="6,3"
                                                                BorderThickness="0,1,0,1"
                                                                BorderBrush="{StaticResource Tool.Divider}">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                    </DataGrid>
                </DockPanel>

            </Grid>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ctl:CadCanvas x:Name="Canvas" Grid.Row="0" />

                <!--
                    The number the tool in hand is working to, typed over the
                    drawing rather than in a corner of the window: the eye is
                    on the cursor, and a measurement shown anywhere else is
                    one nobody reads while drawing. The caption says which
                    number it is: a length, a fillet radius, a chamfer.
                -->
                <Border x:Name="LengthOverlay" Grid.Row="0" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#F21E2530" BorderBrush="#FF5AAFFF" BorderThickness="1"
                        CornerRadius="3" Padding="6,3" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LengthCaption" Text="Length" Foreground="#FF9FB3C8"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="LengthBox" MinWidth="76" Background="Transparent"
                                 Foreground="White" BorderThickness="0" CaretBrush="White"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="OnLengthKey" />
                        <TextBlock x:Name="LengthUnit" Foreground="#FF9FB3C8" VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EmptyHint" Grid.Row="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7F8C99" FontSize="15" IsHitTestVisible="False"
                           Text="Pick a tool from the Draw palette, or open a .dwg&#x0a;Scroll to zoom, middle-drag to pan, click to select"
                           TextAlignment="Center" />

                <!-- Model and paper space sheets, in tab order, as in AutoCAD. -->
                <ListBox x:Name="LayoutTabs" Grid.Row="1" BorderThickness="0,1,0,0"
                         Visibility="Collapsed" SelectionChanged="OnLayoutSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="10,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="4" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!--
                Layers, on the far side of the drawing, with the full height
                of the window. A real file brings fifty of them and names
                like Structural_Section_StairA, so there is a box to find one
                by typing part of its name.
            -->
            <Grid Grid.Column="5" Margin="4">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,4">
                        <TextBlock Text="Layers" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <!--
                            New, properties, delete, then the count. Every one
                            of them goes through the command stack, so a layer
                            made or renamed by mistake is one Ctrl+Z away like
                            anything else.
                        -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="LayerNewButton" Style="{StaticResource PanelButton}" Click="OnNewLayer"
                                    Tag="{StaticResource Icon.LayerNew}" ToolTip="New layer" />
                            <Button x:Name="LayerEditButton" Style="{StaticResource PanelButton}" Click="OnEditLayer"
                                    Tag="{StaticResource Icon.LayerEdit}" ToolTip="Layer properties  -  or double-click the row" />
                            <Button x:Name="LayerDeleteButton" Style="{StaticResource PanelButton}" Click="OnDeleteLayer"
                                    Tag="{StaticResource Icon.LayerDelete}" ToolTip="Delete layer  -  only one with nothing drawn on it" />
                            <TextBlock x:Name="LayerCountText" Opacity="0.6" Margin="6,0,2,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!--
                        The prompt is drawn under the empty box rather than
                        put in a label beside it: a label costs a line of a
                        panel this narrow and says the same thing.
                    -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,4">
                        <TextBox x:Name="LayerFilterBox" Height="22" VerticalContentAlignment="Center"
                                 Padding="4,0,20,0" TextChanged="OnLayerFilterChanged"
                                 PreviewKeyDown="OnLayerFilterKey" />

                        <TextBlock x:Name="LayerFilterPrompt" Text="Find a layer" IsHitTestVisible="False"
                                   Opacity="0.45" Margin="7,0,0,0" VerticalAlignment="Center" />

                        <Button x:Name="LayerFilterClear" Content="&#xd7;" Width="17" Height="17"
                                HorizontalAlignment="Right" Margin="0,0,3,0" Padding="0"
                                Focusable="False" BorderThickness="0" Background="Transparent"
                                Visibility="Collapsed" Click="OnClearLayerFilter"
                                ToolTip="Clear the filter  (Escape)" />
                    </Grid>

                    <ListBox x:Name="LayerList" BorderThickness="1"
                             SelectionChanged="OnLayerSelected"
                             MouseDoubleClick="OnLayerDoubleClick"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                              VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Width="13" Height="13" Margin="4,0,6,0"
                                            Background="{Binding Swatch}" BorderBrush="#66000000"
                                            BorderThickness="1" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3" Text="{Binding EntityCount}" Opacity="0.5"
                                               Margin="6,0,2,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

