<Window x:Class="FreeDWGEditorThatWorks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:FreeDWGEditorThatWorks.Controls"
        mc:Ignorable="d"
        Title="FreeDWG Editor" Height="700" Width="1100">
    <DockPanel>
        <!--
            Icons rather than words: the text toolbar ran out of room at four
            buttons, and a drawing tool that spells out its commands is a
            drawing tool nobody has used before.

            A plain panel rather than a ToolBar, because ToolBar insists on an
            overflow chevron and a drag gripper this window has no use for. It
            showed the chevron with eight buttons and room to spare.
        -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Tool.Divider}" Background="#FFF7F9FC">
            <StackPanel Orientation="Horizontal" Margin="4,3">
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.New}"
                        Click="OnNewClick" ToolTip="New drawing  (Ctrl+N)" />
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Open}"
                        Click="OnOpenClick" ToolTip="Open a DWG or DXF drawing  (Ctrl+O)" />
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Save}"
                        IsEnabled="False" ToolTip="Save  -  arrives with E5, which applies edits back onto the original document" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Undo}"
                        Click="OnUndoClick" IsEnabled="False" ToolTip="Undo  (Ctrl+Z)" />
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Redo}"
                        Click="OnRedoClick" IsEnabled="False" ToolTip="Redo  (Ctrl+Y)" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ZoomExtents}"
                        Click="OnZoomExtentsClick" ToolTip="Zoom extents  -  fit the whole drawing in the viewport" />
                <ToggleButton x:Name="ZoomWindowToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.ZoomWindow}" Click="OnZoomWindowToggled"
                              ToolTip="Zoom window  -  drag a rectangle to zoom into it" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="LineweightsToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Lineweights}" Click="OnLineweightsToggled"
                              ToolTip="Lineweights  -  show plot widths instead of hairlines" />
                <ToggleButton x:Name="LightBackgroundToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Background}" Click="OnBackgroundToggled"
                              ToolTip="Light background" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Grid}" Click="OnGridToggled"
                              ToolTip="Grid  -  show it, and snap to it when nothing else is near" />
                <ToggleButton x:Name="OrthoToggle" Style="{StaticResource ToolCheck}"
                              Tag="{StaticResource Icon.Ortho}" Click="OnSnapToggled"
                              ToolTip="Ortho  -  hold each new point square with the last one" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <ToggleButton x:Name="EndpointSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapEndpoint}" Click="OnSnapToggled"
                              ToolTip="Snap to endpoints and vertices" />
                <ToggleButton x:Name="MidpointSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapMidpoint}" Click="OnSnapToggled"
                              ToolTip="Snap to midpoints" />
                <ToggleButton x:Name="CenterSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapCenter}" Click="OnSnapToggled"
                              ToolTip="Snap to centres of circles, arcs and ellipses" />
                <ToggleButton x:Name="QuadrantSnapToggle" Style="{StaticResource ToolCheck}" IsChecked="True"
                              Tag="{StaticResource Icon.SnapQuadrant}" Click="OnSnapToggled"
                              ToolTip="Snap to quadrants  -  the top, bottom, left and right of a circle" />

                <Rectangle Style="{StaticResource ToolBarDivider}" />

                <!--
                    Fillet radius and chamfer distance share this box: both
                    ask the same question, and zero means a sharp corner in
                    either. It is also the first numeric entry in the app,
                    and where real coordinate entry should grow from.
                -->
                <TextBlock Text="R" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{StaticResource Tool.GroupLabel}" />
                <TextBox x:Name="RadiusBox" Text="0" Width="52" VerticalAlignment="Center"
                         VerticalContentAlignment="Center" TextAlignment="Right"
                         TextChanged="OnRadiusChanged"
                         ToolTip="Fillet radius and chamfer distance. Zero brings the lines to a sharp corner" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="No drawing loaded." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinateText" FontFamily="Consolas" Text="" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="LayerColumn" Width="230" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
                Draw and Modify, in AutoCAD's own order so that muscle memory
                transfers. Three columns because one would be 28 buttons tall and
                run off the bottom of a 700px window; two still needed a scrollbar.

                The tools that are still disabled say in their tooltip what
                they are waiting for. Nothing here touches the drawing
                directly: a tool hands back an entity and the canvas puts it
                on the command stack, which is the only way in.
            -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Tool.Divider}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,2,6">
                        <TextBlock Text="Draw" Style="{StaticResource PaletteGroupLabel}" />

                        <UniformGrid Columns="3" Width="108" HorizontalAlignment="Center">
                            <RadioButton x:Name="SelectButton" GroupName="Tool" Style="{StaticResource ToolToggle}"
                                         Tag="{StaticResource Icon.Select}" IsChecked="True" Click="OnToolPicked"
                                         ToolTip="Select  -  click to pick, drag left to right for a window, right to left to cross" />
                            <RadioButton x:Name="LineButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Line}" ToolTip="Line  -  two points" />
                            <RadioButton x:Name="PolylineButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Polyline}" ToolTip="Polyline  -  any number of points, Enter or right-click to finish" />
                            <RadioButton x:Name="RectangleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Rectangle}" ToolTip="Rectangle  -  two opposite corners" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Polygon}" ToolTip="Polygon  -  needs a side count to ask for, so it waits for command input" />
                            <RadioButton x:Name="CircleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Circle}" ToolTip="Circle  -  centre, then a point on the rim" />
                            <RadioButton x:Name="ArcButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Arc}" ToolTip="Arc  -  start, a point on the arc, then the end" />
                            <RadioButton x:Name="EllipseButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Ellipse}" ToolTip="Ellipse  -  centre, the end of the major axis, then the minor" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Spline}" ToolTip="Spline  -  arrives with the draw tools (E4)" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Point}" ToolTip="Point  -  POINT is not imported yet either" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Hatch}" ToolTip="Hatch  -  arrives with the draw tools (E4)" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Text}" ToolTip="Text  -  arrives with the draw tools (E4)" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Block}" ToolTip="Insert block  -  arrives with the draw tools (E4)" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Dimension}" ToolTip="Dimension  -  needs real dimension layout, which is E5" />
                        </UniformGrid>

                        <Separator Margin="4,8" Background="{StaticResource Tool.Divider}" />
                        <TextBlock Text="Modify" Style="{StaticResource PaletteGroupLabel}" />

                        <UniformGrid Columns="3" Width="108" HorizontalAlignment="Center">
                            <Button x:Name="EraseButton" Style="{StaticResource ToolButton}" Click="OnEraseClick"
                                    Tag="{StaticResource Icon.Erase}" ToolTip="Erase the selection  (Delete)" />
                            <RadioButton x:Name="MoveButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Move}" ToolTip="Move  -  select first, then pick a base point and where it goes" />
                            <RadioButton x:Name="CopyButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Copy}" ToolTip="Copy  -  select first, then pick a base point and where the copy goes" />
                            <RadioButton x:Name="RotateButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Rotate}" ToolTip="Rotate  -  select first, then pick the centre and the angle" />
                            <RadioButton x:Name="ScaleButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Scale}" ToolTip="Scale  -  select first, then pick a base point, a reference and where it should reach" />
                            <RadioButton x:Name="MirrorButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Mirror}" ToolTip="Mirror  -  select first, then pick the mirror line. The original is kept" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Offset}" ToolTip="Offset  -  needs curve offsetting, which is a job of its own for splines and ellipses" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Array}" ToolTip="Array  -  needs somewhere to ask for row and column counts" />
                            <RadioButton x:Name="TrimButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Trim}" ToolTip="Trim  -  click the part of a line or arc to cut away" />
                            <RadioButton x:Name="ExtendButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Extend}" ToolTip="Extend  -  click near the end to push out to its neighbour" />
                            <RadioButton x:Name="FilletButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Fillet}" ToolTip="Fillet  -  click two lines on the sides to keep. Radius 0 makes a sharp corner" />
                            <RadioButton x:Name="ChamferButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Chamfer}" ToolTip="Chamfer  -  click two lines on the sides to keep" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Stretch}" ToolTip="Stretch  -  arrives with grips, which move single vertices rather than whole objects" />
                            <RadioButton GroupName="Tool" Style="{StaticResource ToolToggle}" IsEnabled="False"
                                         Tag="{StaticResource Icon.Explode}" ToolTip="Explode  -  needs breaking a block or a polyline into its parts" />
                            <RadioButton x:Name="TangentButton" GroupName="Tool" Style="{StaticResource ToolToggle}" Click="OnToolPicked"
                                         Tag="{StaticResource Icon.Tangent}" ToolTip="Tangent  -  click a circle, then a line it should sit against" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Column="1" Margin="4">
                <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                    <TextBlock Text="Layers" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="LayerCountText" HorizontalAlignment="Right" Opacity="0.6"
                               VerticalAlignment="Center" />
                </Grid>

                <ListBox x:Name="LayerList" BorderThickness="1"
                         SelectionChanged="OnLayerSelected"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <Border Grid.Column="1" Width="13" Height="13" Margin="4,0,6,0"
                                        Background="{Binding Swatch}" BorderBrush="#66000000"
                                        BorderThickness="1" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3" Text="{Binding EntityCount}" Opacity="0.5"
                                           Margin="6,0,2,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ctl:CadCanvas x:Name="Canvas" Grid.Row="0" />

                <TextBlock x:Name="EmptyHint" Grid.Row="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7F8C99" FontSize="15" IsHitTestVisible="False"
                           Text="Pick a tool from the Draw palette, or open a .dwg&#x0a;Scroll to zoom, middle-drag to pan, click to select"
                           TextAlignment="Center" />

                <!-- Model and paper space sheets, in tab order, as in AutoCAD. -->
                <ListBox x:Name="LayoutTabs" Grid.Row="1" BorderThickness="0,1,0,0"
                         Visibility="Collapsed" SelectionChanged="OnLayoutSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="10,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

