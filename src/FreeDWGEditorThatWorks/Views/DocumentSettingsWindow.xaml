<Window x:Class="FreeDWGEditorThatWorks.Views.DocumentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14" MinWidth="330">
        <TextBlock Text="Units" FontWeight="SemiBold" Margin="0,0,0,6" />

        <ComboBox x:Name="UnitsBox" DisplayMemberPath="Name" SelectedValuePath="Value"
                  SelectionChanged="OnUnitsChanged" />

        <!--
            The scene holds bare numbers and the unit says what they count,
            exactly as DWG's INSUNITS does. Saying so here saves the surprise
            of expecting a drawing to resize when it is relabelled.
        -->
        <TextBlock x:Name="UnitsNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                   Text="Coordinates are plain numbers; the unit says what they count. Changing it relabels the drawing rather than resizing it." />

        <Separator Margin="0,14" />

        <TextBlock Text="Decimal places" FontWeight="SemiBold" Margin="0,0,0,6" />

        <StackPanel Orientation="Horizontal">
            <Slider x:Name="PrecisionSlider" Width="200" Minimum="0" Maximum="6"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnPrecisionChanged" />
            <TextBlock x:Name="PrecisionText" Margin="10,0,0,0" VerticalAlignment="Center"
                       MinWidth="120" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" Width="90" Height="26" IsDefault="True" IsCancel="True"
                    Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
