<Window x:Class="FreeDWGEditorThatWorks.Views.NameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- One box and OK: what a layer group is called, new or renamed. -->
    <StackPanel Margin="14" MinWidth="280">
        <TextBlock x:Name="Prompt" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Height="24" VerticalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="84" Height="26" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="OK" Width="84" Height="26" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
