<Window x:Class="FreeDWGEditorThatWorks.Views.DimensionStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimension style" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14" MinWidth="380">
        <TextBlock TextWrapping="Wrap" Opacity="0.75" MaxWidth="380" Margin="0,0,0,10"
                   Text="The sizes new dimensions are drawn with. Each is multiplied by the overall scale, so a drawing at 1:100 keeps the sizes it plots at and sets the scale to 100." />

        <!--
            Sizes on the left, what each one is on the right. A length can be
            typed in any unit (2.5mm into an inch drawing converts), the
            same as on the canvas.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Text height" VerticalAlignment="Center" Margin="0,3,12,3" />
            <TextBox x:Name="TextHeightBox" Grid.Row="0" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock x:Name="TextHeightUnit" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />

            <TextBlock Grid.Row="1" Text="Arrow size" VerticalAlignment="Center" Margin="0,3,12,3" />
            <TextBox x:Name="ArrowSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock x:Name="ArrowSizeUnit" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />

            <TextBlock Grid.Row="2" Text="Extension line gap" VerticalAlignment="Center" Margin="0,3,12,3"
                       ToolTip="How far short of the measured point an extension line stops (DIMEXO)" />
            <TextBox x:Name="ExtensionOffsetBox" Grid.Row="2" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock x:Name="ExtensionOffsetUnit" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />

            <TextBlock Grid.Row="3" Text="Extension line overrun" VerticalAlignment="Center" Margin="0,3,12,3"
                       ToolTip="How far an extension line carries on past the dimension line (DIMEXE)" />
            <TextBox x:Name="ExtensionBeyondBox" Grid.Row="3" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock x:Name="ExtensionBeyondUnit" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />

            <TextBlock Grid.Row="4" Text="Text gap" VerticalAlignment="Center" Margin="0,3,12,3"
                       ToolTip="Clearance between the number and the dimension line (DIMGAP)" />
            <TextBox x:Name="TextGapBox" Grid.Row="4" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock x:Name="TextGapUnit" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />

            <TextBlock Grid.Row="5" Text="Decimal places" VerticalAlignment="Center" Margin="0,3,12,3" />
            <TextBox x:Name="DecimalsBox" Grid.Row="5" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />

            <Separator Grid.Row="6" Grid.ColumnSpan="3" Margin="0,8" />

            <TextBlock Grid.Row="7" Text="Overall scale" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,3,12,3"
                       ToolTip="Every size above is multiplied by this (DIMSCALE)" />
            <TextBox x:Name="ScaleBox" Grid.Row="7" Grid.Column="1" Margin="0,3" TextChanged="OnFieldChanged" />
            <TextBlock Grid.Row="7" Grid.Column="2" Text="x" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />
        </Grid>

        <!-- What the numbers come to, since the scale makes them two steps removed from what is drawn. -->
        <TextBlock x:Name="Summary" TextWrapping="Wrap" MaxWidth="380" Margin="0,10,0,0" />

        <CheckBox x:Name="RestyleBox" Margin="0,12,0,0" />
        <TextBlock TextWrapping="Wrap" Opacity="0.65" MaxWidth="380" Margin="20,2,0,0" FontSize="11"
                   Text="Dimensions that came in with the file are pictures until AutoCAD regenerates them, and keep their size." />

        <DockPanel Margin="0,18,0,0">
            <Button Content="ISO 129" Width="90" Height="26" Click="OnIso" DockPanel.Dock="Left"
                    ToolTip="2.5 text and arrows, in this drawing's units, at a scale of 1" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="OK" Width="90" Height="26" IsDefault="True" Click="OnOk" />
                <Button Content="Cancel" Width="90" Height="26" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
