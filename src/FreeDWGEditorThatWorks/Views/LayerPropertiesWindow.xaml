<Window x:Class="FreeDWGEditorThatWorks.Views.LayerPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layer" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Name, colour, width and the three switches: everything a layer is.
        The switches are here as well as on the list row because the list has
        room for one checkbox and a layer has three states, and a user who
        cannot find "locked" assumes the drawing is broken.
    -->
    <StackPanel Margin="14" MinWidth="300">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"
                       Margin="0,0,10,6" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                     VerticalContentAlignment="Center" Height="24" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Colour" VerticalAlignment="Center"
                       Margin="0,0,10,6" />
            <Button x:Name="ColourButton" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,6"
                    HorizontalContentAlignment="Left" Click="OnPickColour">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ColourChip" Width="14" Height="14" Margin="4,0,8,0"
                            BorderBrush="#66000000" BorderThickness="1" />
                    <TextBlock x:Name="ColourName" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" VerticalAlignment="Center"
                       Margin="0,0,10,6" />
            <ComboBox x:Name="WeightBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,6"
                      IsEditable="True" VerticalContentAlignment="Center" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="OnBox" Content="On" Margin="0,0,16,0" VerticalAlignment="Center" />
            <CheckBox x:Name="FrozenBox" Content="Frozen" Margin="0,0,16,0" VerticalAlignment="Center" />
            <CheckBox x:Name="LockedBox" Content="Locked" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="Note" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0"
                   Text="Recolouring a layer recolours the objects that were following it. Objects given a colour of their own keep it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="84" Height="26" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="OK" Width="84" Height="26" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
